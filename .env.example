# StoryMaker · variables de entorno.
# NINGUN VALOR REAL EN ESTE FICHERO (encargo, «Sin API keys»; CLAUDE.md §16).

# Ruta del fichero SQLite de la obra. Si no se define, `storymaker.db` en el
# directorio desde el que se lanza el servidor.
STORYMAKER_DB=storymaker.db

# El proveedor se usa POR CONSUMO DE CUENTA, SIN CLAVE (decision P-08): el
# Claude Agent SDK lanza el binario `claude`, que tiene que estar instalado y
# autenticado en la maquina (P-15). Esta variable existe porque
# `Ajustes.desde_entorno` la lee, y se deja VACIA a proposito: si un dia
# hiciera falta una clave, este es su sitio y el repositorio no es.
ANTHROPIC_API_KEY=

# Observabilidad (CLAUDE.md §4.3, RF-OBS-07). Las tres o ninguna: con alguna
# vacia, el sistema arranca, avisa y genera **sin medir nada** (ObservadorNulo).
# Las claves las da el proyecto de Langfuse; aqui van VACIAS.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# El host se lee de LANGFUSE_HOST y, si no esta, de LANGFUSE_BASE_URL, que es
# el nombre que usa el SDK v3 y el que trae un .env copiado del panel. Basta con
# una de las dos; si estan ambas, manda LANGFUSE_HOST.
LANGFUSE_HOST=
# LANGFUSE_BASE_URL=
#
# El backend NO carga este fichero por si solo: las variables tienen que estar
# en el entorno del proceso que lanza uvicorn.

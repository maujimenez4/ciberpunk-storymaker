{
  "config": "storymaker/run-config@1",
  "profile": "smoke-3ch",
  "extends": "../run.base.json",

  "run": {
    "novel": "neon-smoke"
  },

  "scope": {
    "chapters": 3,
    "acts": 1,
    "wordsPerChapter": 350,
    "wordsTolerance": 0.3,
    "summaryWindow": 2
  },

  "research": {
    "maxSearchesSetup": 2,
    "maxSearchesPerChapter": 1
  },

  "limits": {
    "maxRewrites": 1
  },

  "budget": {
    "maxUsd": 5,
    "maxTokens": 300000,
    "maxUsdPerCall": 0.5,
    "onExceed": "stop-after-chapter"
  },

  "output": {
    "outputFormats": ["markdown"]
  },

  "execution": {
    "dryRun": false,
    "dryRunInjectBlockerAt": null
  }
}

# Dependencias
node_modules/

# Secretos y entorno local
.env
.env.*

# Derivados regenerables (invariante 8: Markdown es el formato canónico).
# El manuscrito en Markdown sí se versiona; PDF y EPUB se reconstruyen.
novels/**/out/*.pdf
novels/**/out/*.epub

# Ruido del sistema
Thumbs.db
.DS_Store

# Build del panel. Se reconstruye con `npm run panel`.
tools/dashboard/dist/

# Lock de corrida: estado en vivo con un PID, nunca se versiona.
novels/**/run.lock

# Rastro de decisiones del lock: diagnostico local, no estado del proyecto.
novels/**/.run-lock.log

# Sondeo y andamios de telemetria: diagnostico local, nunca estado del proyecto.
.trace/

# Salida de los evaluators: se regenera con `npm run evals`.
evals/out/

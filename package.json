{
  "name": "ciberpunk-storymaker",
  "version": "0.2.0",
  "description": "Sistema ag\u00e9ntico que escribe novelas largas cap\u00edtulo a cap\u00edtulo, con Claude como orquestador y nueve subagentes especialistas.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test",
    "evals": "node tools/evals/run.mjs",
    "evals:send": "node tools/evals/send.mjs",
    "invariantes": "node tools/check-invariants.mjs",
    "config": "node tools/config.js",
    "panel": "vite build --config tools/dashboard/vite.config.js && node tools/dashboard.mjs",
    "panel:build": "vite build --config tools/dashboard/vite.config.js",
    "panel:dev": "vite --config tools/dashboard/vite.config.js",
    "panel:serve": "node tools/dashboard.mjs",
    "trace:canary": "node .claude/hooks/trace-langfuse.mjs --canary",
    "trace:sweep": "node .claude/hooks/trace-langfuse.mjs --sweep"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "framer-motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
